# Copy to .env.local and fill in. Never commit real keys.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: preferred model. It becomes first in the fallback chain of free
# models (gemma-4-31b -> gemma-4-26b -> nemotron-3-super), tried in order on 429.
# Note: the free-tier daily cap (50/day, 1000/day after a $10 top-up) is
# account-wide, so fallbacks help with per-model congestion, not the daily cap.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
