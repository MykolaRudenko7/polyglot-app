# Copy to .env.local and fill in. Never commit real keys.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model (defaults to openai/gpt-oss-20b:free).
#   Free:  openai/gpt-oss-20b:free  |  google/gemma-4-31b-it:free
#   Paid:  openai/gpt-5-mini  (better quality, needs credit)
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
